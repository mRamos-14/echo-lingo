{
  "zh1-2": [{"f": "statement + 吗 = yes/no question", "ex": "你 好 吗？", "parts": [["你", "you", "n"], ["好", "good / well", "a"], ["吗", "question particle", "p", ["的", "了"]]]}],
  "zh1-3": [{"f": "你 叫 什么 名字？", "ex": "你 叫 什么 名字？", "parts": [["你", "you", "n"], ["叫", "are called", "v", ["是"]], ["什么", "what", "q"], ["名字", "name", "n"]]}],
  "zh1-4": [{"f": "[A] 是 [B]", "ex": "我 是 学生。", "parts": [["我", "I", "n"], ["是", "am", "v", ["很"]], ["学生", "student", "n"]]}],
  "zh1-5": [{"f": "你 是 哪 国 人？", "ex": "你 是 哪 国 人？", "parts": [["你", "you", "n"], ["是", "are", "v"], ["哪", "which", "q", ["什么"]], ["国", "country", "n"], ["人", "person", "n"]]}],
  "zh1-8": [{"f": "number + measure word + noun", "ex": "你 有 几 个 哥哥？", "parts": [["你", "you", "n"], ["有", "have", "v", ["是"]], ["几", "how many", "q"], ["个", "(measure word)", "p", ["本", "杯"]], ["哥哥", "older brothers", "n"]]}],
  "zh1-9": [{"f": "number + 本 + book", "ex": "三 本 书", "parts": [["三", "three", "m"], ["本", "(measure word: books)", "p", ["只", "杯"]], ["书", "books", "n"]]}],
  "zh1-12": [{"f": "这 是 [who]", "ex": "这 是 我 爸爸。", "parts": [["这", "this", "n"], ["是", "is", "v", ["有"]], ["我", "my", "n"], ["爸爸", "dad", "n"]]}],
  "zh1-13": [{"f": "没有 (never 不有)", "ex": "我 没有 弟弟。", "parts": [["我", "I", "n"], ["没有", "don't have", "v", ["不有"]], ["弟弟", "younger brother", "n"]]}],
  "zh1-15": [{"f": "[who] 的 [thing]", "ex": "那 是 我 的 书。", "parts": [["那", "that", "n"], ["是", "is", "v"], ["我", "I", "n"], ["的", "'s", "p", ["吗", "了"]], ["书", "book", "n"]]}],
  "zh1-18": [{"f": "想 + verb = would like to", "ex": "我 想 喝 咖啡。", "parts": [["我", "I", "n"], ["想", "would like to", "m"], ["喝", "drink", "v", ["吃"]], ["咖啡", "coffee", "n"]]}],
  "zh1-19": [{"f": "[thing] 很 + adjective (no 是!)", "ex": "这个 很 好吃。", "parts": [["这个", "this", "n"], ["很", "very", "m", ["是"]], ["好吃", "tasty", "a"]]}],
  "zh1-20": [{"f": "不 + verb = don't", "ex": "我 不 喜欢 咖啡。", "parts": [["我", "I", "n"], ["不", "not", "m", ["没有"]], ["喜欢", "like", "v"], ["咖啡", "coffee", "n"]]}],
  "zh1-22": [{"f": "这 + 本 + 书", "ex": "这 本 书 很 新。", "parts": [["这", "this", "m"], ["本", "(measure word: books)", "p", ["只"]], ["书", "book", "n"], ["很", "very", "m", ["是"]], ["新", "new", "a"]]}],
  "zh1-24": [{"f": "一 只 + animal", "ex": "我 有 一 只 猫。", "parts": [["我", "I", "n"], ["有", "have", "v"], ["一", "one", "m"], ["只", "(measure word: animals)", "p", ["本", "杯"]], ["猫", "cat", "n"]]}],
  "zh1-26": [{"f": "[thing] 在 [place]", "ex": "厕所 在 哪儿？", "parts": [["厕所", "toilet", "n"], ["在", "is at", "v", ["是"]], ["哪儿", "where", "q"]]}],
  "zh1-28": [{"f": "time first, then the action", "ex": "明天 我 去 商店。", "parts": [["明天", "tomorrow", "t"], ["我", "I", "n"], ["去", "go", "v"], ["商店", "shop", "t"]]}],
  "zh1-30": [{"f": "会 + verb = can (a skill)", "ex": "我 会 说 一点儿 汉语。", "parts": [["我", "I", "n"], ["会", "can", "m", ["是"]], ["说", "speak", "v"], ["一点儿", "a little", "m"], ["汉语", "Chinese", "n"]]}],

  "zh2-2": [{"f": "没 + verb = didn't", "ex": "我 没 去。", "parts": [["我", "I", "n"], ["没", "didn't", "m", ["不"]], ["去", "go", "v"]]},
            {"f": "不 + verb = won't / don't", "ex": "我 不 去。", "parts": [["我", "I", "n"], ["不", "not (won't)", "m", ["没"]], ["去", "go", "v"]]}],
  "zh2-3": [{"f": "在 + place + verb", "ex": "我 在 公司 工作。", "parts": [["我", "I", "n"], ["在", "at", "p", ["是"]], ["公司", "company", "t"], ["工作", "work", "v"]]}],
  "zh2-5": [{"f": "坐 + transport + 去 + place", "ex": "我 坐 地铁 去 学校。", "parts": [["我", "I", "n"], ["坐", "take (ride)", "v", ["开"]], ["地铁", "subway", "n"], ["去", "go", "v"], ["学校", "school", "t"]]}],
  "zh2-7": [{"f": "[thing] 在 [place] 上面", "ex": "书 在 桌子 上面。", "parts": [["书", "book", "n"], ["在", "is at", "v", ["是"]], ["桌子", "table", "n"], ["上面", "on top", "t", ["下面"]]]}],
  "zh2-9": [{"f": "… 吧 = let's", "ex": "我们 走 吧。", "parts": [["我们", "we", "n"], ["走", "go", "v"], ["吧", "(let's)", "p", ["吗"]]]}],
  "zh2-10": [{"f": "都 goes before the verb", "ex": "我们 都 是 学生。", "parts": [["我们", "we", "n"], ["都", "all", "m", ["也"]], ["是", "are", "v"], ["学生", "students", "n"]]}],
  "zh2-13": [{"f": "星期 几？", "ex": "今天 星期 几？", "parts": [["今天", "today", "t"], ["星期", "day of the week", "n"], ["几", "which number", "q", ["什么"]]]}],
  "zh2-14": [{"f": "几 点？", "ex": "现在 几 点？", "parts": [["现在", "now", "t"], ["几", "what (number)", "q"], ["点", "o'clock", "n", ["个"]]]}],
  "zh2-16": [{"f": "太 … 了！ = too …!", "ex": "太 贵 了！", "parts": [["太", "too", "m", ["很"]], ["贵", "expensive", "a"], ["了", "(!)", "p"]]}],
  "zh2-18": [{"f": "一 双 + shoes", "ex": "我 想 买 一 双 鞋。", "parts": [["我", "I", "n"], ["想", "would like to", "m"], ["买", "buy", "v", ["卖"]], ["一", "one", "m"], ["双", "pair", "p", ["本"]], ["鞋", "shoes", "n"]]}],
  "zh2-21": [{"f": "who + time + action", "ex": "我 七 点 起床。", "parts": [["我", "I", "n"], ["七", "seven", "m"], ["点", "o'clock", "n"], ["起床", "get up", "v", ["睡觉"]]]}],
  "zh2-25": [{"f": "和 [person] 一起 + verb", "ex": "我 和 朋友 一起 去。", "parts": [["我", "I", "n"], ["和", "with", "p", ["的"]], ["朋友", "friend", "n"], ["一起", "together", "m"], ["去", "go", "v"]]}],
  "zh2-26": [{"f": "question words stay in place", "ex": "你 什么时候 来？", "parts": [["你", "you", "n"], ["什么时候", "when", "q", ["哪儿"]], ["来", "come", "v"]]}],

  "zh3-1": [{"f": "verb + 了 = done", "ex": "他 去 了 北京。", "parts": [["他", "he", "n"], ["去", "go", "v"], ["了", "(done)", "p", ["吗"]], ["北京", "Beijing", "t"]]}],
  "zh3-2": [{"f": "还 没 + verb = not yet", "ex": "他 还 没 来。", "parts": [["他", "he", "n"], ["还", "still", "m"], ["没", "not (yet)", "m", ["不"]], ["来", "come", "v"]]}],
  "zh3-4": [{"f": "… 了 at the end = something changed", "ex": "下雨 了。", "parts": [["下雨", "rain", "v"], ["了", "(it's started)", "p", ["吗"]]]}],
  "zh3-6": [{"f": "在 + verb = doing right now", "ex": "我 在 看 电视。", "parts": [["我", "I", "n"], ["在", "(right now)", "m", ["了"]], ["看", "watch", "v"], ["电视", "TV", "n"]]}],
  "zh3-9": [{"f": "会 = can (a learned skill)", "ex": "我 会 开车。", "parts": [["我", "I", "n"], ["会", "can (skill)", "m", ["是"]], ["开车", "drive", "v"]]},
            {"f": "可以 = may (permission)", "ex": "这里 可以 拍照 吗？", "parts": [["这里", "here", "t"], ["可以", "may", "m", ["会"]], ["拍照", "take photos", "v"], ["吗", "question", "p"]]}],
  "zh3-10": [{"f": "一起 + verb + 吧", "ex": "我们 一起 吃饭 吧。", "parts": [["我们", "we", "n"], ["一起", "together", "m"], ["吃饭", "eat", "v"], ["吧", "(let's)", "p", ["吗"]]]}],
  "zh3-11": [{"f": "A 比 B + adjective", "ex": "我 比 他 高。", "parts": [["我", "I", "n"], ["比", "than", "p", ["很"]], ["他", "him", "n"], ["高", "tall", "a"]]}],
  "zh3-12": [{"f": "最 + adjective = the most", "ex": "他 最 高。", "parts": [["他", "he", "n"], ["最", "most", "m", ["比"]], ["高", "tall", "a"]]}],
  "zh3-16": [{"f": "一 张 + ticket", "ex": "我 要 买 一 张 票。", "parts": [["我", "I", "n"], ["要", "want to", "m"], ["买", "buy", "v", ["卖"]], ["一", "one", "m"], ["张", "(measure word: flat things)", "p", ["只", "本"]], ["票", "ticket", "n"]]}],
  "zh3-18": [{"f": "从 A 到 B", "ex": "从 这儿 到 机场 多 远？", "parts": [["从", "from", "p", ["到"]], ["这儿", "here", "t"], ["到", "to", "p", ["从"]], ["机场", "airport", "t"], ["多", "how", "q"], ["远", "far", "a"]]}],
  "zh3-20": [{"f": "verb + 了 = it happened", "ex": "我 迷路 了。", "parts": [["我", "I", "n"], ["迷路", "get lost", "v"], ["了", "(it happened)", "p", ["吗"]]]}],
  "zh3-23": [{"f": "应该 + verb = should", "ex": "你 应该 去 医院。", "parts": [["你", "you", "n"], ["应该", "should", "m"], ["去", "go", "v"], ["医院", "hospital", "t"]]}],
  "zh3-25": [{"f": "因为 …， 所以 …", "ex": "因为 下雨， 所以 我 不 去。", "parts": [["因为", "because", "p", ["但是"]], ["下雨", "it's raining", "v"], ["所以", "so", "p", ["因为"]], ["我", "I", "n"], ["不", "not", "m"], ["去", "go", "v"]]}],
  "zh3-27": [{"f": "别 + verb = don't", "ex": "别 担心。", "parts": [["别", "don't", "m", ["很"]], ["担心", "worry", "v"]]}]
}
