{
 "lang": "ko",
 "tier": 1,
 "name": "Kindergarten",
 "sub": "Greetings, numbers, family, food and your first sentences",
 "lessons": [
  {
   "id": "ko1-1",
   "title": "Saying goodbye",
   "unit": "Unit 1 · Hello",
   "learn": [
    {
     "h": "Two goodbyes",
     "p": "Korean has two goodbyes. Say <b>안녕히 가세요</b> (go in peace) to someone who is leaving, and <b>안녕히 계세요</b> (stay in peace) to someone who stays while you leave.",
     "ex": [
      "ko-안녕히 가세요",
      "ko-안녕히 계세요"
     ]
    }
   ],
   "items": [
    {
     "id": "ko-안녕히 가세요",
     "w": "안녕히 가세요",
     "r": "annyeonghi gaseyo",
     "m": "goodbye (to someone leaving)",
     "kind": "sent",
     "toks": [
      "안녕히",
      "가세요"
     ]
    },
    {
     "id": "ko-안녕히 계세요",
     "w": "안녕히 계세요",
     "r": "annyeonghi gyeseyo",
     "m": "goodbye (to someone staying)",
     "kind": "sent",
     "toks": [
      "안녕히",
      "계세요"
     ]
    },
    {
     "id": "ko-반가워요",
     "w": "반가워요",
     "r": "bangawoyo",
     "m": "nice to meet you",
     "kind": "word"
    },
    {
     "id": "ko-고마워요",
     "w": "고마워요",
     "r": "gomawoyo",
     "m": "thanks",
     "kind": "word"
    },
    {
     "id": "ko-죄송합니다",
     "w": "죄송합니다",
     "r": "joesonghamnida",
     "m": "I'm very sorry",
     "kind": "word"
    },
    {
     "id": "ko-괜찮아요",
     "w": "괜찮아요",
     "r": "gwaenchanayo",
     "m": "it's okay",
     "kind": "word"
    }
   ]
  },
  {
   "id": "ko1-2",
   "title": "Polite little words",
   "learn": [
    {
     "h": "The polite -요",
     "p": "Ending a sentence with <b>요</b> makes it polite and friendly. It's the safe style for almost everyone. Endings in <b>-니다</b> are even more formal: news, speeches, shop staff."
    }
   ],
   "items": [
    {
     "id": "ko-잘",
     "w": "잘",
     "r": "jal",
     "m": "well",
     "kind": "word"
    },
