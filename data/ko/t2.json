{
 "lang": "ko",
 "tier": 2,
 "name": "Lower elementary",
 "sub": "Present-tense verbs, places, time, shopping and daily life (≈ TOPIK 1)",
 "lessons": [
  {
   "id": "ko2-1",
   "title": "How verbs work",
   "unit": "Unit 1 · Verbs",
   "learn": [
    {
     "h": "Dictionary form",
     "p": "Every verb in the dictionary ends in <b>-다</b>: 가다 (to go), 보다 (to see). To speak politely, drop 다 and add a 요-ending."
    },
    {
     "h": "하다 verbs",
     "p": "Many verbs are a noun + <b>하다</b> (to do): 공부 (study) + 하다. In polite speech 하다 becomes <b>해요</b>: 공부해요.",
     "ex": [
      "ko-저는 공부해요."
     ]
    }
   ],
   "items": [
    {
     "id": "ko-가다",
     "w": "가다",
     "r": "gada",
     "m": "to go (dictionary form)",
     "kind": "word"
    },
    {
     "id": "ko-오다",
     "w": "오다",
     "r": "oda",
     "m": "to come (dictionary form)",
     "kind": "word"
    },
    {
     "id": "ko-보다",
     "w": "보다",
     "r": "boda",
     "m": "to see (dictionary form)",
     "kind": "word"
    },
    {
     "id": "ko-하다",
     "w": "하다",
     "r": "hada",
     "m": "to do (dictionary form)",
     "kind": "word"
    },
    {
     "id": "ko-공부",
     "w": "공부",
     "r": "gongbu",
     "m": "study (noun)",
     "kind": "word"
    },
    {
     "id": "ko-공부하다",
     "w": "공부하다",
     "r": "gongbuhada",
     "m": "to study (dictionary form)",
     "kind": "word"
    },
    {
     "id": "ko-저는 공부해요.",
     "w": "저는 공부해요.",
     "r": "jeoneun gongbuhaeyo.",
     "m": "I study.",
     "kind": "sent",
     "toks": [
      "저는",
      "공부해요"
     ]
    }
   ],
   "grammar": [
    {
     "f": "하다 → 해요",
     "ex": "ko-저는 공부해요.",
     "parts": [
      {
       "w": "저",
       "m": "I",
       "r": "n"
      },
      {
       "w": "는",
       "m": "topic marker",
       "r": "p",
       "alt": [
        "을"
       ]
      },
      {
       "w": "공부해요",
       "m": "study",
       "r": "v",
       "alt": [
        "공부하요"
       ]
      }
     ]
    }
   ]
  },
  {
