  {
   "id": "zh2-5",
   "title": "By subway",
   "learn": [
    {
     "h": "坐 = take (transport)",
     "p": "You “sit” on transport: <b>坐</b> 地铁 = take the subway. A car you drive: <b>开车</b>.",
     "ex": [
      "zh-我坐地铁去学校。"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-坐",
     "w": "坐",
     "r": "zuò",
     "m": "to sit / take (transport)",
     "kind": "char"
    },
    {
     "id": "zh-开车",
     "w": "开车",
     "r": "kāichē",
     "m": "to drive",
     "kind": "word"
    },
    {
