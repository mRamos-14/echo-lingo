     "toks": [
      "我",
      "在",
      "公司",
      "工作"
     ]
    }
   ],
   "grammar": [
    {
     "f": "在 + place + verb",
     "ex": "zh-我在公司工作。",
     "parts": [
      {
       "w": "我",
       "m": "I",
       "r": "n"
      },
      {
