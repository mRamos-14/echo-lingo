     "r": "hǎo ba.",
     "m": "Okay then.",
     "kind": "sent",
     "toks": [
      "好",
      "吧"
     ]
    },
    {
     "id": "zh-是吗？",
     "w": "是吗？",
     "r": "shì ma?",
     "m": "Really?",
     "kind": "sent",
     "toks": [
      "是",
      "吗"
     ]
    }
   ],
   "grammar": [
    {
     "f": "… 吧 = let's",
     "ex": "zh-我们走吧。",
     "parts": [
      {
       "w": "我们",
       "m": "we",
       "r": "n"
      },
      {
