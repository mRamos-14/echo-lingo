{
 "lang": "zh",
 "tier": 2,
 "name": "Lower elementary",
 "sub": "Everyday verbs, places, time, shopping and daily life (≈ HSK 1)",
 "lessons": [
  {
   "id": "zh2-1",
   "title": "Everyday verbs",
   "unit": "Unit 1 · Doing things",
   "learn": [
    {
     "h": "Verbs never change",
     "p": "Chinese verbs have no endings: 我听, 他听, 我们听 all use the same 听. Time words and little helper words show when things happen."
    }
   ],
   "items": [
    {
     "id": "zh-听",
     "w": "听",
     "r": "tīng",
     "m": "to listen",
     "kind": "char"
    },
    {
     "id": "zh-写",
     "w": "写",
     "r": "xiě",
     "m": "to write",
     "kind": "char"
    },
    {
     "id": "zh-读",
     "w": "读",
     "r": "dú",
     "m": "to read aloud",
     "kind": "char"
    },
    {
     "id": "zh-学习",
     "w": "学习",
     "r": "xuéxí",
     "m": "to study",
     "kind": "word"
    },
    {
     "id": "zh-音乐",
     "w": "音乐",
     "r": "yīnyuè",
     "m": "music",
     "kind": "word"
    },
    {
     "id": "zh-我学习汉语。",
     "w": "我学习汉语。",
     "r": "wǒ xuéxí Hànyǔ.",
     "m": "I study Chinese.",
     "kind": "sent",
     "toks": [
      "我",
      "学习",
      "汉语"
     ]
    },
    {
     "id": "zh-他听音乐。",
     "w": "他听音乐。",
     "r": "tā tīng yīnyuè.",
     "m": "He listens to music.",
     "kind": "sent",
     "toks": [
      "他",
      "听",
      "音乐"
     ]
    }
   ]
  },
  {
   "id": "zh2-2",
   "title": "不 and 没",
   "learn": [
    {
     "h": "Two kinds of “not”",
     "p": "<b>不</b> (bù) = don't / won't (habits, the future). <b>没</b> (méi) = didn't / haven't (the past). 我不去 = I'm not going. 我没去 = I didn't go.",
     "ex": [
      "zh-我不去。",
      "zh-我没去。"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-不",
     "w": "不",
     "r": "bù",
     "m": "not / don't",
     "kind": "char"
    },
    {
     "id": "zh-没",
     "w": "没",
     "r": "méi",
     "m": "didn't / haven't",
     "kind": "char"
    },
    {
     "id": "zh-酒",
     "w": "酒",
     "r": "jiǔ",
     "m": "alcohol",
     "kind": "char"
    },
    {
     "id": "zh-我不去。",
     "w": "我不去。",
     "r": "wǒ bú qù.",
     "m": "I'm not going.",
     "kind": "sent",
     "toks": [
      "我",
      "不",
      "去"
     ]
    },
    {
     "id": "zh-我没去。",
     "w": "我没去。",
     "r": "wǒ méi qù.",
     "m": "I didn't go.",
     "kind": "sent",
     "toks": [
      "我",
      "没",
      "去"
     ]
    },
    {
     "id": "zh-他不喝酒。",
     "w": "他不喝酒。",
     "r": "tā bù hē jiǔ.",
     "m": "He doesn't drink alcohol.",
     "kind": "sent",
     "toks": [
      "他",
      "不",
      "喝",
      "酒"
     ]
    }
   ],
   "grammar": [
    {
     "f": "没 + verb = didn't",
     "ex": "zh-我没去。",
     "parts": [
      {
       "w": "我",
       "m": "I",
       "r": "n"
      },
      {
       "w": "没",
       "m": "didn't",
       "r": "m",
       "alt": [
        "不"
       ]
      },
      {
       "w": "去",
       "m": "go",
       "r": "v"
      }
     ]
    },
    {
     "f": "不 + verb = won't / don't",
     "ex": "zh-我不去。",
     "parts": [
      {
       "w": "我",
       "m": "I",
       "r": "n"
      },
      {
       "w": "不",
       "m": "not (won't)",
       "r": "m",
       "alt": [
        "没"
       ]
      },
      {
       "w": "去",
       "m": "go",
       "r": "v"
      }
     ]
    }
   ]
  },
  {
