  {
   "id": "zh2-9",
   "title": "Little sentence endings",
   "learn": [
    {
     "h": "吧 and 呢",
     "p": "<b>吧</b> (ba) softens a suggestion: 我们走吧 = let's go. <b>呢</b> (ne) asks “what about…?” or “where's…?”: 你的书呢？ = where's your book?",
     "ex": [
      "zh-我们走吧。"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-吧",
     "w": "吧",
     "r": "ba",
     "m": "(softens a suggestion)",
     "kind": "word"
    },
    {
     "id": "zh-对",
     "w": "对",
     "r": "duì",
     "m": "correct / right",
     "kind": "char"
    },
    {
     "id": "zh-我们走吧。",
     "w": "我们走吧。",
     "r": "wǒmen zǒu ba.",
     "m": "Let's go.",
     "kind": "sent",
     "toks": [
      "我们",
      "走",
      "吧"
     ]
    },
    {
     "id": "zh-你的书呢？",
