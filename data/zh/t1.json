{
 "lang": "zh",
 "tier": 1,
 "name": "Kindergarten",
 "sub": "Greetings, numbers, family, food and your first sentences",
 "lessons": [
  {
   "id": "zh1-1",
   "title": "Greetings",
   "unit": "Unit 1 · Hello",
   "learn": [
    {
     "h": "Polite hello",
     "p": "<b>您好</b> (nín hǎo) is the respectful hello for elders, teachers and customers. 您 is the polite “you”.",
     "ex": [
      "zh-您好"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-您好",
     "w": "您好",
     "r": "nín hǎo",
     "m": "hello (polite)",
     "kind": "word"
    },
    {
     "id": "zh-早上好",
     "w": "早上好",
     "r": "zǎoshang hǎo",
     "m": "good morning",
     "kind": "word"
    },
    {
     "id": "zh-晚上好",
     "w": "晚上好",
     "r": "wǎnshang hǎo",
     "m": "good evening",
     "kind": "word"
    },
    {
     "id": "zh-拜拜",
     "w": "拜拜",
     "r": "báibái",
     "m": "bye-bye",
     "kind": "word"
    },
    {
     "id": "zh-不客气",
     "w": "不客气",
     "r": "bú kèqi",
     "m": "you're welcome",
     "kind": "word"
    },
    {
     "id": "zh-没关系",
     "w": "没关系",
     "r": "méi guānxi",
     "m": "it's okay / no problem",
     "kind": "word"
    },
    {
     "id": "zh-老师，您好！",
     "w": "老师，您好！",
     "r": "lǎoshī, nín hǎo!",
     "m": "Hello, teacher!",
     "kind": "sent",
     "toks": [
      "老师",
      "您好"
     ]
    },
    {
     "id": "zh-早上好，老师！",
     "w": "早上好，老师！",
     "r": "zǎoshang hǎo, lǎoshī!",
     "m": "Good morning, teacher!",
     "kind": "sent",
     "toks": [
      "早上好",
      "老师"
     ]
    }
   ]
  },
  {
   "id": "zh1-2",
   "title": "How are you?",
   "learn": [
    {
     "h": "吗 makes a question",
     "p": "Add <b>吗</b> (ma) to the end of any statement to make a yes/no question: 你好吗？ = How are you? <b>呢</b> (ne) means “and you?”.",
     "ex": [
      "zh-你好吗？",
      "zh-你呢？"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-我",
     "w": "我",
     "r": "wǒ",
     "m": "I / me",
     "kind": "char"
    },
    {
     "id": "zh-也",
     "w": "也",
     "r": "yě",
     "m": "also / too",
     "kind": "char"
    },
    {
     "id": "zh-你好吗？",
     "w": "你好吗？",
     "r": "nǐ hǎo ma?",
     "m": "How are you?",
     "kind": "sent",
     "toks": [
      "你",
      "好",
      "吗"
     ]
    },
    {
     "id": "zh-我很好。",
     "w": "我很好。",
     "r": "wǒ hěn hǎo.",
     "m": "I'm very well.",
     "kind": "sent",
     "toks": [
      "我",
      "很",
      "好"
     ]
    },
    {
     "id": "zh-你呢？",
     "w": "你呢？",
     "r": "nǐ ne?",
     "m": "And you?",
     "kind": "sent",
     "toks": [
      "你",
      "呢"
     ]
    },
    {
     "id": "zh-我也很好。",
     "w": "我也很好。",
     "r": "wǒ yě hěn hǎo.",
     "m": "I'm well too.",
     "kind": "sent",
     "toks": [
      "我",
      "也",
      "很",
      "好"
     ]
    }
   ],
   "grammar": [
    {
     "f": "statement + 吗 = yes/no question",
     "ex": "zh-你好吗？",
     "parts": [
      {
       "w": "你",
       "m": "you",
       "r": "n"
      },
      {
       "w": "好",
       "m": "good / well",
       "r": "a"
      },
      {
       "w": "吗",
       "m": "question particle",
       "r": "p",
       "alt": [
        "的",
        "了"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "zh1-3",
   "title": "What's your name?",
   "learn": [
    {
     "h": "Question words stay in place",
     "p": "Chinese doesn't move question words to the front. Just put <b>什么</b> (what) where the answer goes: 你叫什么名字？ = You are called what name?",
     "ex": [
      "zh-你叫什么名字？"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-叫",
     "w": "叫",
     "r": "jiào",
     "m": "to be called",
     "kind": "char"
    },
    {
     "id": "zh-名字",
     "w": "名字",
     "r": "míngzi",
     "m": "name",
     "kind": "word"
    },
    {
     "id": "zh-什么",
     "w": "什么",
     "r": "shénme",
     "m": "what",
     "kind": "word"
    },
    {
     "id": "zh-你叫什么名字？",
     "w": "你叫什么名字？",
     "r": "nǐ jiào shénme míngzi?",
     "m": "What's your name?",
     "kind": "sent",
     "toks": [
      "你",
      "叫",
      "什么",
      "名字"
     ]
    },
    {
     "id": "zh-我叫大卫。",
     "w": "我叫大卫。",
     "r": "wǒ jiào Dàwèi.",
     "m": "My name is David.",
     "kind": "sent",
     "toks": [
      "我",
      "叫",
      "大卫"
     ]
    }
   ],
   "grammar": [
    {
     "f": "你 叫 什么 名字？",
     "ex": "zh-你叫什么名字？",
     "parts": [
      {
       "w": "你",
       "m": "you",
       "r": "n"
      },
      {
       "w": "叫",
       "m": "are called",
       "r": "v",
       "alt": [
        "是"
       ]
      },
      {
       "w": "什么",
       "m": "what",
       "r": "q"
      },
      {
       "w": "名字",
       "m": "name",
       "r": "n"
      }
     ]
    }
   ]
  },
  {
   "id": "zh1-4",
   "title": "I am a student",
   "learn": [
    {
     "h": "是 = to be",
     "p": "<b>是</b> (shì) links two nouns: 我是学生 = I am a student. Verbs never change in Chinese: 我是, 你是, 他是.",
     "ex": [
      "zh-我是学生。"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-她",
     "w": "她",
     "r": "tā",
     "m": "she / her",
     "kind": "char"
    },
    {
     "id": "zh-我们",
     "w": "我们",
     "r": "wǒmen",
     "m": "we / us",
     "kind": "word"
    },
    {
     "id": "zh-他们",
     "w": "他们",
     "r": "tāmen",
     "m": "they / them",
     "kind": "word"
    },
    {
     "id": "zh-我是学生。",
     "w": "我是学生。",
     "r": "wǒ shì xuésheng.",
     "m": "I am a student.",
     "kind": "sent",
     "toks": [
      "我",
      "是",
      "学生"
     ]
    },
    {
     "id": "zh-他是老师吗？",
     "w": "他是老师吗？",
     "r": "tā shì lǎoshī ma?",
     "m": "Is he a teacher?",
     "kind": "sent",
     "toks": [
      "他",
      "是",
      "老师",
      "吗"
     ]
    },
    {
     "id": "zh-她是我朋友。",
     "w": "她是我朋友。",
     "r": "tā shì wǒ péngyou.",
     "m": "She is my friend.",
     "kind": "sent",
     "toks": [
      "她",
      "是",
      "我",
      "朋友"
     ]
    }
   ],
   "grammar": [
    {
     "f": "[A] 是 [B]",
     "ex": "zh-我是学生。",
     "parts": [
      {
       "w": "我",
       "m": "I",
       "r": "n"
      },
      {
       "w": "是",
       "m": "am",
       "r": "v",
       "alt": [
        "很"
       ]
      },
      {
       "w": "学生",
       "m": "student",
       "r": "n"
      }
     ]
    }
   ]
  },
