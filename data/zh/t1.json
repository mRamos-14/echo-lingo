   "learn": [
    {
     "h": "Numbers are logical",
     "p": "11 = 十一 (ten-one), 20 = 二十 (two-ten), 99 = 九十九. For “two of something” use <b>两</b> (liǎng), not 二: 两个.",
     "ex": [
      "zh-两个"
     ]
    }
   ],
   "items": [
    {
