{
 "lang": "zh",
 "tier": 3,
 "name": "Upper elementary",
 "sub": "了 and 过, plans, comparisons, travel and polite requests (≈ HSK 2)",
 "lessons": [
  {
   "id": "zh3-1",
   "title": "Done: 了",
   "unit": "Unit 1 · Done and experienced",
   "learn": [
    {
     "h": "了 after a verb",
     "p": "<b>了</b> (le) right after a verb means the action is done: 我吃了 = I ate / I've eaten. There's no other past tense to learn!",
     "ex": [
      "zh-我吃了。"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-了",
     "w": "了",
     "r": "le",
     "m": "(marks a completed action)",
     "kind": "word"
    },
    {
     "id": "zh-北京",
     "w": "北京",
     "r": "Běijīng",
     "m": "Beijing",
     "kind": "word"
    },
    {
     "id": "zh-我吃了。",
     "w": "我吃了。",
     "r": "wǒ chī le.",
     "m": "I've eaten.",
     "kind": "sent",
     "toks": [
      "我",
      "吃",
      "了"
     ]
    },
    {
     "id": "zh-他去了北京。",
     "w": "他去了北京。",
     "r": "tā qù le Běijīng.",
     "m": "He went to Beijing.",
     "kind": "sent",
     "toks": [
      "他",
      "去",
      "了",
      "北京"
     ]
    },
    {
     "id": "zh-你买了什么？",
     "w": "你买了什么？",
     "r": "nǐ mǎi le shénme?",
     "m": "What did you buy?",
     "kind": "sent",
     "toks": [
      "你",
      "买",
      "了",
      "什么"
     ]
    }
   ],
   "grammar": [
    {
     "f": "verb + 了 = done",
     "ex": "zh-他去了北京。",
     "parts": [
      {
       "w": "他",
       "m": "he",
       "r": "n"
      },
      {
       "w": "去",
       "m": "go",
       "r": "v"
      },
      {
       "w": "了",
       "m": "(done)",
       "r": "p",
       "alt": [
        "吗"
       ]
      },
      {
       "w": "北京",
       "m": "Beijing",
       "r": "t"
      }
     ]
    }
   ]
  },
  {
   "id": "zh3-2",
   "title": "Not yet",
   "learn": [
    {
     "h": "没 for the past",
     "p": "A past action that didn't happen uses <b>没</b> and drops 了: 我没吃早饭 = I didn't eat breakfast. <b>还没</b> = not yet.",
     "ex": [
      "zh-他还没来。"
     ]
    }
   ],
   "items": [
    {
     "id": "zh-还",
     "w": "还",
     "r": "hái",
     "m": "still / yet",
     "kind": "char"
    },
    {
     "id": "zh-已经",
     "w": "已经",
     "r": "yǐjīng",
     "m": "already",
     "kind": "word"
    },
    {
     "id": "zh-我没吃早饭。",
     "w": "我没吃早饭。",
     "r": "wǒ méi chī zǎofàn.",
     "m": "I didn't eat breakfast.",
     "kind": "sent",
     "toks": [
      "我",
      "没",
      "吃",
      "早饭"
     ]
    },
    {
     "id": "zh-他还没来。",
     "w": "他还没来。",
     "r": "tā hái méi lái.",
     "m": "He hasn't come yet.",
     "kind": "sent",
     "toks": [
      "他",
      "还",
      "没",
      "来"
     ]
    },
    {
     "id": "zh-我已经吃了。",
     "w": "我已经吃了。",
     "r": "wǒ yǐjīng chī le.",
     "m": "I've already eaten.",
     "kind": "sent",
     "toks": [
      "我",
      "已经",
      "吃",
      "了"
     ]
    }
   ],
   "grammar": [
    {
     "f": "还 没 + verb = not yet",
     "ex": "zh-他还没来。",
     "parts": [
      {
       "w": "他",
       "m": "he",
       "r": "n"
      },
      {
       "w": "还",
       "m": "still",
       "r": "m"
      },
      {
       "w": "没",
       "m": "not (yet)",
       "r": "m",
       "alt": [
        "不"
       ]
      },
      {
       "w": "来",
       "m": "come",
       "r": "v"
      }
     ]
    }
   ]
  },
