        {"id": "ja-yama", "w": "山", "k": "やま", "r": "yama", "m": "mountain", "kind": "word", "cousin": "Chinese 山 shān · Korean 산 san"},
        {"id": "ja-hito", "w": "人", "k": "ひと", "r": "hito", "m": "person", "kind": "word", "cousin": "Chinese 人 rén"}
      ],
      "build": [
