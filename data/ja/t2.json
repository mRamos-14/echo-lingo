  {
   "id": "ja2-10",
   "title": "Me too",
   "learn": [
    {
     "h": "も = also",
     "p": "<b>も</b> replaces は or が to mean “also / too”: わたし も がくせい です = I'm a student too. Boys and men often say <b>ぼく</b> for “I”.",
     "ex": [
      "ja-わたし も がくせい です。"
     ]
    }
   ],
   "items": [
    {
     "id": "ja-ぼく",
