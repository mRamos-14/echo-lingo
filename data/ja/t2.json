  {
   "id": "ja2-4",
   "title": "Where you do things",
   "learn": [
    {
     "h": "で = at (actions)",
     "p": "<b>で</b> marks where an action happens: としょかん で べんきょう します = I study at the library. Korean uses 에서 the same way.",
     "ex": [
      "ja-としょかん で べんきょう します。"
     ]
    }
   ],
   "items": [
    {
     "id": "ja-としょかん",
     "w": "としょかん",
     "r": "toshokan",
     "m": "library",
     "kind": "word"
    },
    {
     "id": "ja-レストラン",
     "w": "レストラン",
     "r": "resutoran",
     "m": "restaurant",
     "kind": "word"
    },
    {
     "id": "ja-へや",
     "w": "へや",
     "r": "heya",
     "m": "room",
     "kind": "word"
    },
    {
     "id": "ja-としょかん で べんきょう します。",
     "w": "としょかん で べんきょう します。",
     "r": "toshokan de benkyō shimasu.",
     "m": "I study at the library.",
     "kind": "sent",
     "say": "としょかんでべんきょうします。",
     "toks": [
      "としょかん",
      "で",
      "べんきょう",
      "します"
     ]
    },
    {
     "id": "ja-レストラン で ごはん を たべます。",
     "w": "レストラン で ごはん を たべます。",
     "r": "resutoran de gohan o tabemasu.",
