{
 "lang": "ja",
 "tier": 2,
 "name": "Lower elementary",
 "sub": "Polite verbs, particles, adjectives, time and shopping (≈ JLPT N5)",
 "lessons": [
  {
   "id": "ja2-1",
   "title": "The ます form",
   "unit": "Unit 1 · Verbs",
   "learn": [
    {
     "h": "Polite verbs end in ます",
     "p": "Polite verbs end in <b>ます</b>: みます (see), ききます (listen), よみます (read). Unlike English, the verb never changes for I / you / he / she."
    }
   ],
   "items": [
    {
     "id": "ja-みます",
     "w": "みます",
     "r": "mimasu",
     "m": "see / watch",
     "kind": "word"
    },
    {
     "id": "ja-ききます",
     "w": "ききます",
     "r": "kikimasu",
     "m": "listen / hear",
     "kind": "word"
    },
    {
     "id": "ja-よみます",
     "w": "よみます",
     "r": "yomimasu",
     "m": "read",
     "kind": "word"
    },
    {
     "id": "ja-かきます",
     "w": "かきます",
     "r": "kakimasu",
     "m": "write",
     "kind": "word"
    },
    {
     "id": "ja-おんがく",
     "w": "おんがく",
     "r": "ongaku",
     "m": "music",
     "kind": "word"
    },
    {
     "id": "ja-ほん を よみます。",
     "w": "ほん を よみます。",
     "r": "hon o yomimasu.",
     "m": "I read a book.",
     "kind": "sent",
     "say": "ほんおよみます。",
     "toks": [
      "ほん",
      "を",
      "よみます"
     ]
    },
    {
     "id": "ja-おんがく を ききます。",
     "w": "おんがく を ききます。",
     "r": "ongaku o kikimasu.",
     "m": "I listen to music.",
     "kind": "sent",
     "say": "おんがくおききます。",
     "toks": [
      "おんがく",
      "を",
      "ききます"
     ]
    }
   ],
   "grammar": [
    {
     "f": "[thing] を + ます verb",
     "ex": "ja-ほん を よみます。",
     "parts": [
      {
       "w": "ほん",
       "m": "book",
       "r": "n"
      },
      {
       "w": "を",
       "m": "object marker",
       "r": "p",
       "alt": [
        "が",
        "に"
       ]
      },
      {
       "w": "よみます",
       "m": "read",
       "r": "v"
      }
     ]
    }
   ]
  },
  {
   "id": "ja2-2",
   "title": "Saying no",
   "learn": [
    {
     "h": "ます → ません",
     "p": "To make a verb negative, change <b>ます</b> to <b>ません</b>: たべます → たべません (don't eat).",
     "ex": [
      "ja-たべません"
     ]
    }
   ],
   "items": [
    {
     "id": "ja-たべません",
     "w": "たべません",
     "r": "tabemasen",
     "m": "don't eat",
     "kind": "word"
    },
    {
     "id": "ja-いきません",
     "w": "いきません",
     "r": "ikimasen",
     "m": "don't go",
     "kind": "word"
    },
    {
     "id": "ja-のみません",
     "w": "のみません",
     "r": "nomimasen",
     "m": "don't drink",
     "kind": "word"
    },
    {
     "id": "ja-にく を たべません。",
     "w": "にく を たべません。",
     "r": "niku o tabemasen.",
     "m": "I don't eat meat.",
     "kind": "sent",
     "say": "にくおたべません。",
     "toks": [
      "にく",
      "を",
      "たべません"
     ]
    },
    {
     "id": "ja-あした は いきません。",
     "w": "あした は いきません。",
     "r": "ashita wa ikimasen.",
     "m": "I'm not going tomorrow.",
     "kind": "sent",
     "say": "あしたわいきません。",
     "toks": [
      "あした",
      "は",
      "いきません"
     ]
    }
   ],
   "grammar": [
    {
     "f": "ます → ません",
     "ex": "ja-にく を たべません。",
     "parts": [
      {
       "w": "にく",
       "m": "meat",
       "r": "n"
      },
      {
       "w": "を",
       "m": "object marker",
       "r": "p",
       "alt": [
        "に"
       ]
      },
      {
       "w": "たべません",
       "m": "don't eat",
       "r": "v",
       "alt": [
        "たべます"
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "ja2-3",
   "title": "Doing things",
   "learn": [
    {
     "h": "します",
     "p": "<b>します</b> means “do”. Many activities are noun + します: べんきょう します (study), しごと を します (work)."
    }
   ],
   "items": [
