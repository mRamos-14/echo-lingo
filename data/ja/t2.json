     "kind": "sent",
     "say": "レストランでごはんおたべます。",
     "toks": [
      "レストラン",
      "で",
      "ごはん",
      "を",
      "たべます"
     ]
    }
   ],
   "grammar": [
    {
     "f": "[place] で + action",
     "ex": "ja-としょかん で べんきょう します。",
     "parts": [
      {
       "w": "としょかん",
       "m": "library",
       "r": "t"
