  {
   "id": "ja1-2",
   "title": "Nice to meet you",
   "learn": [
    {
     "h": "A は B です",
     "p": "<b>[A] は [B] です</b> means “A is B”. Remember: the particle は is read <b>wa</b>. わたし は マリア です = I am Maria.",
     "ex": [
      "ja-わたし は マリア です。"
     ]
    }
   ],
   "items": [
    {
     "id": "ja-はじめまして",
     "w": "はじめまして",
     "r": "hajimemashite",
     "m": "nice to meet you (first meeting)",
     "kind": "word"
    },
    {
     "id": "ja-よろしく おねがいします",
     "w": "よろしく おねがいします",
     "r": "yoroshiku onegaishimasu",
     "m": "pleased to meet you",
     "kind": "sent",
     "say": "よろしくおねがいします",
     "toks": [
      "よろしく",
      "おねがいします"
     ]
    },
    {
     "id": "ja-わたし",
     "w": "わたし",
     "r": "watashi",
     "m": "I / me",
     "kind": "word"
    },
    {
     "id": "ja-なまえ",
     "w": "なまえ",
     "r": "namae",
     "m": "name",
     "kind": "word"
    },
    {
     "id": "ja-わたし は マリア です。",
     "w": "わたし は マリア です。",
     "r": "watashi wa Maria desu.",
     "m": "I am Maria.",
     "kind": "sent",
