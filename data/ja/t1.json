  {
   "id": "ja1-3",
   "title": "I am a student",
   "learn": [
    {
     "h": "か makes a question",
     "p": "Put <b>か</b> at the end of a sentence to make it a question. No change in word order: せんせい です か = Are you a teacher?",
     "ex": [
      "ja-せんせい です か。"
     ]
    }
   ],
