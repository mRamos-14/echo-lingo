   "id": "ja1-1",
   "title": "Greetings",
   "unit": "Unit 1 · Hello",
   "learn": [
    {
     "h": "Polite add-ons",
     "p": "Adding <b>ございます</b> makes a greeting polite: おはよう (morning, casual) → おはよう ございます (good morning, polite). Use the polite form with anyone you don't know well.",
     "ex": [
      "ja-おはよう ございます"
     ]
    }
   ],
   "items": [
    {
     "id": "ja-おはよう ございます",
